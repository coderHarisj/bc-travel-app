    style ROLLBACK   fill:#fce4ec,stroke:#880e4f,color:#880e4f
    style SUCCESS    fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20
    style APPROVAL   fill:#fff9c4,stroke:#f9a825,color:#4e342e
    style SECRETS    fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
