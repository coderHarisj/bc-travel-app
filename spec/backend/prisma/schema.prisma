/// TABLE: library_items
/// PURPOSE: Reusable travel items — saved locations, hotels, city guides
/// OWNER: itinerary-team
/// RETENTION: Indefinite (soft delete)
/// SENSITIVE FIELDS: none
/// LAST REVIEWED: 2026-02-28
/// ACCESS PATTERN: Read-heavy (searched and browsed in library panel)
///
/// NULLABLE FIELD REGISTER:
/// description → optional detailed description
/// metadata    → optional JSONB for type-specific data (currency, attractions, etc.)
/// imageUrl    → optional image
/// deletedAt   → soft delete
/// deletedBy   → who deleted
model LibraryItem {
    libraryItemId  BigInt @id @default(autoincrement()) @map("library_item_id")
    libraryItemKey String @unique @default(uuid()) @map("library_item_key") @db.Uuid

    itemType    LibraryItemType @map("item_type")
    name        String          @db.VarChar(255)
    description String?         @db.Text // NULLABLE: optional
    imageUrl    String?         @map("image_url") @db.VarChar(500) // NULLABLE: optional
    metadata    Json?           @db.JsonB // NULLABLE: type-specific data (country info, currency, etc.)

    // --- Audit fields ---
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
    createdBy BigInt   @map("created_by")
    updatedBy BigInt   @map("updated_by")

    // --- Soft delete ---
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz() // NULLABLE: soft delete
    deletedBy BigInt?   @map("deleted_by") // NULLABLE: who deleted

    /// INDEX: idx_library_items_item_type
    /// SERVES QUERY: Q8 — list library items by type
    /// QUERY PATTERN: WHERE item_type = ? AND deleted_at IS NULL
    @@index([itemType], map: "idx_library_items_item_type")
    @@index([deletedAt], map: "idx_library_items_deleted_at")
    @@map("library_items")
}

// =============================================================================
// COLLABORATION DOMAIN
// =============================================================================

/// TABLE: discussions
/// PURPOSE: One discussion thread per itinerary for team collaboration
/// OWNER: collaboration-team
/// RETENTION: 1 year after itinerary archival
/// SENSITIVE FIELDS: none
/// LAST REVIEWED: 2026-02-28
/// ACCESS PATTERN: Read-heavy (loaded with itinerary detail; messages paginated)
///
/// NULLABLE FIELD REGISTER:
/// deletedAt → soft delete
/// deletedBy → who deleted
model Discussion {
    discussionId  BigInt @id @default(autoincrement()) @map("discussion_id")
    discussionKey String @unique @default(uuid()) @map("discussion_key") @db.Uuid

    itineraryId BigInt @unique @map("itinerary_id")

    // --- Audit fields ---
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
    createdBy BigInt   @map("created_by")
    updatedBy BigInt   @map("updated_by")

    // --- Soft delete ---
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz() // NULLABLE: soft delete
    deletedBy BigInt?   @map("deleted_by") // NULLABLE: who deleted

    // --- Relations ---
    itinerary Itinerary           @relation(fields: [itineraryId], references: [itineraryId], onDelete: Cascade)
    messages  DiscussionMessage[]

    @@index([itineraryId], map: "idx_discussions_itinerary_id")
    @@index([deletedAt], map: "idx_discussions_deleted_at")
    @@map("discussions")
}

/// TABLE: discussion_messages
/// PURPOSE: Individual chat messages within a discussion thread
/// OWNER: collaboration-team
/// RETENTION: 1 year after parent itinerary archival
/// SENSITIVE FIELDS: none
/// LAST REVIEWED: 2026-02-28
/// ACCESS PATTERN: Append-heavy (new messages added frequently); read for message history
///
/// NULLABLE FIELD REGISTER: (none — all fields required)
///
/// SCALABILITY SIGN-OFF: discussion_messages
/// [x] Projected row count: ~5M at 1 year
/// [x] Cursor pagination via discussion_message_id
/// [x] Partitioning assessed — not required yet (<50M)
model DiscussionMessage {
    discussionMessageId  BigInt @id @default(autoincrement()) @map("discussion_message_id")
    discussionMessageKey String @unique @default(uuid()) @map("discussion_message_key") @db.Uuid

    discussionId BigInt @map("discussion_id")
    content      String @db.Text

    // --- Audit fields ---
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
    createdBy BigInt   @map("created_by")
    updatedBy BigInt   @map("updated_by")

    // --- Relations ---
    discussion Discussion @relation(fields: [discussionId], references: [discussionId], onDelete: Cascade)

    /// INDEX: idx_discussion_messages_discussion_id
    /// SERVES QUERY: Q7 — get messages for a discussion, ordered by time
    /// QUERY PATTERN: WHERE discussion_id = ? ORDER BY created_at ASC
    @@index([discussionId, createdAt], map: "idx_discussion_messages_discussion_created")
    @@map("discussion_messages")
}
